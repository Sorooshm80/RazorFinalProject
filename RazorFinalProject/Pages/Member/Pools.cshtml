@page
@model Web.Pages.Member.PoolsModel
<h2>Pools</h2>
<p class="text-info">@Model.Message</p>

<form method="get" class="mb-3">
    <select asp-for="PoolId" asp-items='new SelectList(Model.AllPools, "Id", "Name")'></select>
    <input asp-for="Date" type="date" />
    <button class="btn btn-secondary">Show sessions</button>
</form>

<table class="table">
    <tr><th>Session</th><th>Price</th><th></th></tr>
    @foreach (var s in Model.Sessions)
    {
        <tr>
            <td>@s.Description</td>
            <td>@s.Price</td>
            <td>
                <form method="post">
                    <input type="hidden" name="PoolId" value="@Model.PoolId" />
                    <input type="hidden" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                    <button class="btn btn-outline-primary" asp-page-handler="Reserve" asp-route-sessionId="@s.Id">Reserve</button>
                    <button class="btn btn-success" asp-page-handler="Enter" asp-route-sessionId="@s.Id">Enter today</button>
                </form>
            </td>
        </tr>
    }
</table>
