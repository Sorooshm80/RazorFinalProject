@page
@model Web.Pages.Admin.ReportsModel
<h2>Reports</h2>

<h4>1. Visits of one customer</h4>
<form method="post" asp-page-handler="Visits" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label asp-for="CustomerId1" class="form-label">Customer ID</label>
        <input asp-for="CustomerId1" type="number" min="1" class="form-control" />
    </div>
    <div class="col-auto">
        <label asp-for="Days1" class="form-label">Number of past days</label>
        <input asp-for="Days1" type="number" min="1" class="form-control" />
    </div>
    <div class="col-auto"><button class="btn btn-primary">Show visits</button></div>
</form>
@if (Model.Report1 != null)
{
    <table class="table">
        <tr><th>Date</th><th>Pool</th><th>Session</th></tr>
        @foreach (var r in Model.Report1)
        {
            <tr><td>@r.VisitDate</td><td>@r.PoolName</td><td>@r.SessionText</td></tr>
        }
    </table>
}

<hr />
<h4>2. Top pools by number of visitors</h4>
<form method="post" asp-page-handler="TopPools" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label asp-for="Days2" class="form-label">Number of past days</label>
        <input asp-for="Days2" type="number" min="1" class="form-control" />
    </div>
    <div class="col-auto">
        <label asp-for="TopCount" class="form-label">How many pools to show (top N)</label>
        <input asp-for="TopCount" type="number" min="1" class="form-control" />
    </div>
    <div class="col-auto"><button class="btn btn-primary">Show top pools</button></div>
</form>
@if (Model.Report2 != null)
{
    <table class="table">
        <tr><th>Pool</th><th>Visitors</th></tr>
        @foreach (var r in Model.Report2)
        {
            <tr><td>@r.PoolName</td><td>@r.VisitCount</td></tr>
        }
    </table>
}

<hr />
<h4>3. Busiest pool on a date</h4>
<form method="post" asp-page-handler="Busiest" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label asp-for="Date3" class="form-label">Date</label>
        <input asp-for="Date3" type="date" class="form-control" />
    </div>
    <div class="col-auto"><button class="btn btn-primary">Show busiest pool</button></div>
</form>
@if (Model.Report3Done)
{
    @if (Model.Report3 == null)
    {
        <p>No visits on this date.</p>
    }
    else
    {

        <p><strong>@Model.Report3.PoolName</strong> (@Model.Report3.VisitCount visitors)</p>
    }
}

<hr />
<h4>4. Reserved sessions customers did not attend</h4>
<form method="post" asp-page-handler="Missed" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label asp-for="Days4" class="form-label">Number of past days</label>
        <input asp-for="Days4" type="number" min="1" class="form-control" />
    </div>
    <div class="col-auto"><button class="btn btn-primary">Show missed reservations</button></div>
</form>
@if (Model.Report4 != null)
{
    <table class="table">
        <tr><th>Customer</th><th>Pool</th><th>Date</th><th>Session</th></tr>
        @foreach (var r in Model.Report4)
        {
            <tr><td>@r.CustomerName</td><td>@r.PoolName</td><td>@r.Date.ToString("yyyy-MM-dd")</td><td>@r.SessionText</td></tr>
        }
    </table>
}
